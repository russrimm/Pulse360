{
  "name": "mcviewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prisma-migrate-if-configured.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "check:lockfile": "node scripts/check-lockfile.mjs && node --test tests/lockfile-provenance.test.mjs",
    "clean": "rimraf .next",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "format": "prettier --write .",
    "dotfiles:sync": "node scripts/sync-dotfiles.mjs",
    "dotfiles:check": "node scripts/sync-dotfiles.mjs --dry-run",
    "dotfiles:sync:all": "node scripts/sync-dotfiles.mjs --all-repos --scan-root ..",
    "dotfiles:bootstrap": "node scripts/bootstrap-dotfiles.mjs",
    "dotfiles:bootstrap:all": "node scripts/bootstrap-dotfiles.mjs --all-repos --scan-root .."
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "@types/sanitize-html": "^2.16.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "baseline-browser-mapping": "^2.10.38",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "next": "^16.2.11",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanitize-html": "^2.17.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@playwright/test": "^1.57.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "autoprefixer": "^10.4.23",
    "esbuild": "0.27.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-react": "^7.37.5",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.10",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "rimraf": "^6.1.2",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.16": "1.1.17",
      "brace-expansion@2.1.2": "2.1.3",
      "brace-expansion@5.0.7": "5.0.8",
      "exceljs>uuid": "^11.1.1",
      "fast-uri": "^3.1.4",
      "postcss": "$postcss",
      "sharp": "$sharp",
      "valibot": "^1.4.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "core-js-compat",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": ">=9.0.0"
  }
}
