// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String   // hashed!
  firstName  String
  lastName   String
  company    String
  preferences Preference[]
}

model Preference {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  key    String
  value  String
}

model PublishedListing {
  id               String   @id @default(uuid())
  product          String
  edition          String
  release          String?
  supportPolicy    String?
  startDate        Int?
  mainstreamDate   Int?
  extendedEndDate  Int?
  retirementDate   Int?
  releaseStartDate Int?
  releaseEndDate   Int?
  docsUrl          String?

  @@unique([product, edition, release])
}

/// Cached copy of a Microsoft 365 Message Center message. Graph drops
/// archived/expired messages from its live feed, so we persist everything
/// here and mark rows that disappear from Graph as "archived" instead of
/// deleting them. `status` is derived during sync:
///   active   -> present in the latest Graph fetch
///   archived -> previously seen, no longer returned by Graph
///   expired  -> `actionRequiredByDateTime` has passed
model MessageCenterUpdate {
  id                       String    @id
  title                    String
  service                  String[]  @default([])
  tags                     String[]  @default([])
  content                  String
  summary                  String
  details                  Json      @default("[]")
  isMajorChange            Boolean   @default(false)
  severity                 String?
  actionRequiredByDateTime DateTime?
  published                DateTime?
  lastUpdated              DateTime?
  status                   String    @default("active")
  firstSeenAt              DateTime  @default(now())
  lastSeenAt               DateTime  @default(now())
  archivedAt               DateTime?

  @@index([status])
  @@index([lastUpdated])
}

/// Tracks the last successful sync for on-demand TTL refresh.
model SyncState {
  key        String    @id
  lastSyncAt DateTime
  lastError  String?
  updatedAt  DateTime  @updatedAt
}
