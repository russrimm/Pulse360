// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Cached copy of a Microsoft 365 Message Center message. Graph drops
/// archived/expired messages from its live feed, so we persist everything
/// here and mark rows that disappear from Graph as "archived" instead of
/// deleting them. `status` is derived during sync:
///   active   -> present in the latest Graph fetch
///   archived -> previously seen, no longer returned by Graph
///   expired  -> `actionRequiredByDateTime` has passed
model MessageCenterUpdate {
  id                       String    @id
  title                    String
  service                  String[]  @default([])
  tags                     String[]  @default([])
  content                  String
  summary                  String
  details                  Json      @default("[]")
  isMajorChange            Boolean   @default(false)
  severity                 String?
  actionRequiredByDateTime DateTime?
  published                DateTime?
  lastUpdated              DateTime?
  status                   String    @default("active")
  firstSeenAt              DateTime  @default(now())
  lastSeenAt               DateTime  @default(now())
  archivedAt               DateTime?

  @@index([status])
  @@index([lastUpdated])
}

/// Tracks the last successful sync for on-demand TTL refresh.
model SyncState {
  key        String    @id
  lastSyncAt DateTime
  lastError  String?
  updatedAt  DateTime  @updatedAt
}

/// Shared server-side cache (serverless-safe replacement for in-process Maps).
/// `key` is a caller-built, namespaced hash; expired rows are purged lazily.
model ApiCache {
  key       String   @id
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Per-route daily request counter used by the Postgres-backed rate limiter.
/// `day` is a UTC date key (YYYY-MM-DD).
model ApiUsage {
  day       String
  route     String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([day, route])
}

/// Weekly Customer Briefing archive, written by the Monday cron
/// (/api/cron/briefing-snapshot). `weekKey` is the briefing Monday as
/// YYYY-MM-DD (UTC); `product` is 'power-platform' or 'copilot-studio'.
model BriefingSnapshot {
  id        String   @id @default(cuid())
  weekKey   String
  product   String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekKey, product])
}
