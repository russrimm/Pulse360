# Pulse 360° — environment variable template
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# Never commit real secrets. See README.md → Configuration for full details.

# --- Required: Microsoft Graph (app-only credentials) ---------------------
# Needed for the /message-center route. Create an Entra app registration with
# the Application permission `ServiceMessage.Read.All` (admin-consented).

# Application (client) ID of the Entra app registration
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Client secret value — treat as a password and rotate regularly
AZURE_CLIENT_SECRET=replace_with_real_secret_value


# --- Optional: Graph base URL override ------------------------------------
# Defaults to https://graph.microsoft.com/v1.0. Only override for national
# clouds (e.g. Gov, China) or when routing through Azure API Management.
# AZURE_API_URL=https://graph.microsoft.com/v1.0


# --- Optional: Postgres (Prisma) ------------------------------------------
# Required for the /message-center route, which caches Graph results in
# Postgres via Prisma. See README.md → Database (Prisma) for the Neon
# quickstart. Leave unset if you don't use the Message Center cache.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"


# --- Optional: NextAuth ---------------------------------------------------
# Only required if you wire up the [...nextauth] route for user sign-in.
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace_with_random_32_byte_base64_string
