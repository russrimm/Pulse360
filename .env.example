# Pulse 360° — environment variable template
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# Never commit real secrets. See README.md → Configuration for full details.

# --- Required: Microsoft Graph (app-only credentials) ---------------------
# Needed for the /message-center route. Create an Entra app registration with
# the Application permission `ServiceMessage.Read.All` (admin-consented).

# Application (client) ID of the Entra app registration
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Client secret value — treat as a password and rotate regularly
AZURE_CLIENT_SECRET=replace_with_real_secret_value


# --- Optional: Graph base URL override ------------------------------------
# Defaults to https://graph.microsoft.com/v1.0. Only override for national
# clouds (e.g. Gov, China) or when routing through Azure API Management.
# AZURE_API_URL=https://graph.microsoft.com/v1.0


# --- Optional: Postgres (Prisma) ------------------------------------------
# Required for the /message-center route, which caches Graph results in
# Postgres via Prisma. See README.md → Database (Prisma) for the Neon
# quickstart. Leave unset if you don't use the Message Center cache.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"


# --- Recommended in production: tenant sign-in ---------------------------
# Message Center is served openly until one of these is true: interactive
# sign-in is configured below (anonymous callers are redirected to sign in),
# or MESSAGE_CENTER_PUBLIC=false is set (routes fail closed). Use a separate,
# single-tenant Entra app registration for interactive sign-in.
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:3011
# NEXTAUTH_SECRET=replace_with_random_32_byte_base64_string
# AUTH_AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AUTH_AZURE_AD_CLIENT_SECRET=replace_with_interactive_app_secret
# AUTH_AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000

# Override the default. true = always anonymous, even with sign-in configured.
# false = never anonymous; blocks Message Center when sign-in is unconfigured.
# MESSAGE_CENTER_PUBLIC=


# --- Scheduled Message Center sync ----------------------------------------
# Shared bearer secret used by /api/cron/sync-messages and its scheduler.
# Generate with: openssl rand -base64 32
# CRON_SECRET=replace_with_random_32_byte_base64_string
